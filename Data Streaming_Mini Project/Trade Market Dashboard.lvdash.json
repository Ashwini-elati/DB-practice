{
  "datasets": [
    {
      "name": "trade_market_base",
      "displayName": "Trade Market Gold Metrics",
      "queryLines": [
        "SELECT\n",
        "  window.start AS window_start,\n",
        "  window.end AS window_end,\n",
        "  symbol,\n",
        "  trade_count,\n",
        "  gross_value,\n",
        "  buy_value,\n",
        "  sell_value\n",
        "FROM\n",
        "  streaming_demo.trades.stream_gold_symbol_metrics"
      ]
    },
    {
      "name": "top_symbols_volume",
      "displayName": "Trade Count by Symbol",
      "queryLines": [
        "SELECT\n",
        "  symbol,\n",
        "  SUM(trade_count) AS total_trades\n",
        "FROM\n",
        "  streaming_demo.trades.stream_gold_symbol_metrics\n",
        "GROUP BY\n",
        "  symbol\n",
        "ORDER BY\n",
        "  total_trades DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "top_symbols_value",
      "displayName": "Trading Value by Symbol",
      "queryLines": [
        "SELECT\n",
        "  symbol,\n",
        "  SUM(gross_value) AS total_gross_value\n",
        "FROM\n",
        "  streaming_demo.trades.stream_gold_symbol_metrics\n",
        "GROUP BY\n",
        "  symbol\n",
        "ORDER BY\n",
        "  total_gross_value DESC\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "buy_sell_summary",
      "displayName": "Buy vs Sell by Symbol",
      "queryLines": [
        "SELECT\n",
        "  symbol,\n",
        "  'Buy' AS side_type,\n",
        "  SUM(buy_value) AS total_value\n",
        "FROM\n",
        "  streaming_demo.trades.stream_gold_symbol_metrics\n",
        "GROUP BY\n",
        "  symbol\n",
        "UNION ALL\n",
        "SELECT\n",
        "  symbol,\n",
        "  'Sell' AS side_type,\n",
        "  SUM(sell_value) AS total_value\n",
        "FROM\n",
        "  streaming_demo.trades.stream_gold_symbol_metrics\n",
        "GROUP BY\n",
        "  symbol"
      ]
    }
  ],
